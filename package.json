{
  "name": "pi-ask-user-enhanced",
  "version": "0.17.2-enhanced.1.4.1",
  "description": "Unofficial enhanced fork of pi-ask-user: the interactive ask_user tool for Pi, with a scrollable preview, fullscreen and adaptive sizing, mouse support and checkbox-style custom text",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "ask",
    "ask_user",
    "interactive"
  ],
  "author": "Enzo Lucchesi <enzo@edl.sh>",
  "contributors": [
    "droyed (https://github.com/droyed)"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/droyed/pi-ask-user-enhanced.git"
  },
  "bugs": {
    "url": "https://github.com/droyed/pi-ask-user-enhanced/issues"
  },
  "homepage": "https://github.com/droyed/pi-ask-user-enhanced#readme",
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "index.ts",
    "settings.ts",
    "single-select-layout.ts",
    "tern.ts",
    "enhanced-ui.ts",
    "skills",
    "ENHANCED.md",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "bun@1.3.14",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check:host": "node scripts/host-smoke.mjs",
    "check:docs": "node scripts/check-doc-examples.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check": "bun run test && bun run typecheck && bun run check:host && bun run check:docs && bun run check:package"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@earendil-works/pi-tui": "1.0.2",
    "@sinclair/typebox": "0.34.52",
    "@types/bun": "1.3.14",
    "@types/node": "22.19.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.74.0",
    "@earendil-works/pi-tui": ">=0.74.0",
    "@sinclair/typebox": "*"
  }
}
